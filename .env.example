# Copy this file to .env and set real values:  cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# Compose profile(s) the default `docker compose up` activates (#6):
#   minimal    = agentlens + lore (+ lore-db) — observability + memory
#   governance = minimal + agentgate (approval gateway / guardrails)
#   full       = alias of governance (everything)
# Override per-command: `docker compose --profile minimal up`.
COMPOSE_PROFILES=full
#
# These are LOCAL-DEV placeholders. Generate fresh values for any
# non-local use (e.g. `openssl rand -hex 32`).

# API key AgentLens uses to call the Lore service. Must match a key the
# Lore instance accepts.
LORE_API_KEY=lore_sk_localdev_replace_me

# AgentGate admin API key.
ADMIN_API_KEY=agentkit-local-dev-admin-key

# AgentGate JWT signing secret.
JWT_SECRET=agentkit-local-dev-jwt-secret-change-me
